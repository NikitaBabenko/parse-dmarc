# Public username, not a secret. Owner can change it in Project Settings.
HTTP_AUTH_USER=pilot-owner
# Intentionally blank: VibeNest Compose generates a unique 192-bit password,
# persists it as a sensitive variable, then supplies it at runtime.
# Outside VibeNest, generate your own unique password (minimum 24 characters).
# Never commit the resulting .env or place real credentials in this file.
HTTP_AUTH_PASSWORD=
